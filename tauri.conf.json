{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "抖音下载工具",
  "version": "1.1.0",
  "identifier": "local.douyin.downloader",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "抖音下载工具",
        "width": 1060,
        "height": 780,
        "minWidth": 860,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#f7f6f2",
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}